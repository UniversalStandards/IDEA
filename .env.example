# =============================================================
# Universal Standard MCP Server — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================

# =========================================================
# Core Runtime
# =========================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Options: error | warn | info | http | verbose | debug | silly
# Note: 'silly' is blocked in NODE_ENV=production

# =========================================================
# Transport
# =========================================================
MCP_TRANSPORT=http
# Options: http | http2 | stdio | sse | websocket | grpc
# - http     : HTTP listener with the MCP Streamable HTTP endpoint (MCP_HTTP_PATH),
#              REST API, admin API and health probes
# - http2    : same over HTTP/2 cleartext
# - stdio    : MCP over stdin/stdout (Docker MCP Toolkit, Claude Desktop, CLI
#              clients). No network listener unless STDIO_ENABLE_HTTP=true; the
#              process exits when the client closes stdin.
# - sse      : HTTP + server-sent event stream at GET /mcp/sse
# - websocket: HTTP + WebSocket transport at GET /mcp/ws
# - grpc     : HTTP + gRPC transport on GRPC_PORT

# ---- MCP Streamable HTTP endpoint (all HTTP-based modes) ----
MCP_HTTP_ENABLED=true
MCP_HTTP_PATH=/mcp
# Bearer token clients send as "Authorization: Bearer <token>" (min 32 chars).
# A JWT signed with JWT_SECRET is also accepted. REQUIRED in production.
# Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Only behind an authenticating reverse proxy:
MCP_ALLOW_UNAUTHENTICATED=false
# Host-header allowlist; enables DNS-rebinding protection (e.g. localhost:3000,hub.example.com)
MCP_ALLOWED_HOSTS=
MCP_MAX_SESSIONS=100
MCP_SESSION_IDLE_TIMEOUT_MS=1800000

# ---- stdio mode ----
# Also open the HTTP listener (health/admin/REST) while serving stdio:
STDIO_ENABLE_HTTP=false

# =========================================================
# AI Routing
# =========================================================
DEFAULT_AI_PROVIDER=openai
FALLBACK_AI_PROVIDER=anthropic
LOCAL_MODEL_PROVIDER=ollama
ENABLE_MULTI_PROVIDER_ROUTING=true

# =========================================================
# Registry Sources
# =========================================================
ENABLE_GITHUB_REGISTRY=true
ENABLE_OFFICIAL_MCP_REGISTRY=true
OFFICIAL_MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io
# Per-registry deadline for discovery; a slow or rate-limited source is skipped
DISCOVERY_TIMEOUT_MS=10000
ENABLE_ENTERPRISE_CATALOG=false
ENABLE_LOCAL_WORKSPACE_SCAN=true

# =========================================================
# GitHub / SCM
# =========================================================
# Optional; raises GitHub API rate limits for GitHub registry discovery.
GITHUB_TOKEN=
GITHUB_REPO=your-org/universal-mcp-orchestration-hub
GITHUB_BRANCH=main

# =========================================================
# Security
# =========================================================
JWT_SECRET=replace_with_long_secure_value_at_least_32_chars
ENCRYPTION_KEY=replace_with_exactly_32_byte_hex_secret_here!
CORS_ORIGIN=*
# For production: CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com
ENABLE_SIGNATURE_VALIDATION=true
ENABLE_POLICY_ENGINE=true
REQUIRE_APPROVAL_FOR_HIGH_RISK_ACTIONS=true

# =========================================================
# Rate Limiting
# =========================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
TRANSPORT_MAX_CONNECTIONS_PER_CLIENT=25
GRPC_PORT=50051

# =========================================================
# Enterprise Catalog (only when ENABLE_ENTERPRISE_CATALOG=true)
# =========================================================
ENTERPRISE_CATALOG_URL=
# ENTERPRISE_CATALOG_PATH=/path/to/catalog.json

# =========================================================
# Webhooks / Events Adapter
# =========================================================
WEBHOOK_SECRET=replace_with_hex_webhook_secret
EVENT_DEDUP_WINDOW_MS=300000

# =========================================================
# Cost Monitoring
# =========================================================
COST_TRACKING_ENABLED=true
COST_BUDGET_DAILY_USD=0
# Set to a positive number to enable daily budget alerts (0 = no limit)

# =========================================================
# Provisioning (installed MCP servers)
# =========================================================
CACHE_TTL=3600
MAX_CONCURRENT_INSTALLS=5
ENABLE_AUTO_UPDATES=false
ENABLE_RUNTIME_HEALTH_RECOVERY=true
# Persistent data: installed tools + install state (default ./.mcp; /data/.mcp in the image)
HUB_DATA_DIR=
# npm preinstall/postinstall scripts of installed tools run arbitrary code; off by default
INSTALL_ALLOW_LIFECYCLE_SCRIPTS=false
INSTALL_TIMEOUT_MS=300000
# Downstream MCP server processes: idle shutdown and first-start timeout
DOWNSTREAM_IDLE_TIMEOUT_MS=600000
DOWNSTREAM_CONNECT_TIMEOUT_MS=120000

# ---- Human approval for high-risk actions ----
# Tool IDs the operator pre-approves (audited), e.g. official:memory,official:time
AUTO_APPROVE_TOOLS=
# How long an in-client approval prompt (MCP elicitation) waits
APPROVAL_ELICITATION_TIMEOUT_MS=120000

# ---- Tool credentials ----
# TOOL_<TOOLNAME>__<VAR> is injected as <VAR> into that tool's process only.
# Tool processes never inherit the hub's own secrets.
# TOOL_GITHUB__GITHUB_PERSONAL_ACCESS_TOKEN=
# TOOL_WEB_SEARCH__BRAVE_API_KEY=

# =========================================================
# Redis (reserved for distributed mode; not used by this release)
# =========================================================
REDIS_URL=

# =========================================================
# UpCloud Worker Factory (ephemeral browser/desktop sessions)
# Only required when ENABLE_UPCLOUD_WORKER_FACTORY=true
# See docs/gates/upcloud-worker-factory.md for the full contract
# =========================================================
ENABLE_UPCLOUD_WORKER_FACTORY=false
UPCLOUD_BROKER_URL=
UPCLOUD_BROKER_API_KEY=
WORKER_SESSION_DEFAULT_TTL_MS=900000
WORKER_SESSION_MAX_TTL_MS=3600000
WORKER_POOL_WARM_SIZE=0

# =========================================================
# HashiCorp Vault (dynamic secret leasing for worker sessions)
# Only required when ENABLE_UPCLOUD_WORKER_FACTORY=true
# =========================================================
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_SECRET_MOUNT=secret

# =========================================================
# Observability
# =========================================================
# File logs (production): directory and on/off. Console logs go to stderr in stdio mode.
LOG_DIR=
LOG_FILE_ENABLED=true
LOG_TO_STDERR=false
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_AUDIT_LOGGING=true
